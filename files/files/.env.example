# IntelliHire AI - Environment Variables
# Rename this file to .env and fill in your values

# MongoDB Connection (local or Atlas)
MONGO_URI=mongodb://localhost:27017/intellihire

# JWT Secret Key (change this to a strong random string)
JWT_SECRET=intellihire_your_strong_secret_key_here

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=replace_with_server_only_key

# Server Port
PORT=5000

# Frontend origin allowed to use the API
CLIENT_ORIGIN=http://localhost:3000
